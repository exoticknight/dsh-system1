{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "declarationDir": "lib/types",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "emitDeclarationOnly": true,
    "types": ["node", "react"]
  },
  "include": ["src/client/**/*.ts"],
  "exclude": []
}
