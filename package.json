{
  "name": "dsh-system1",
  "version": "0.1.0",
  "description": "Typed System One decision service for DeepSeek Harness plugins",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "system-one",
    "system1",
    "decision-service",
    "cordis",
    "typescript",
    "typesafe",
    "jev"
  ],
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "import": "./lib/contracts/index.js"
    },
    "./providers/typesafe": {
      "types": "./lib/providers/typesafe/index.d.ts",
      "import": "./lib/providers/typesafe/index.js"
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "docs",
    "examples"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "format": "prettier --write src tests examples scripts package.json tsconfig*.json cordis.patch.yml README.md README.zh-CN.md CONTRIBUTING.md CONTRIBUTING.zh-CN.md docs .github/workflows",
    "format:check": "prettier --check src tests examples scripts package.json tsconfig*.json cordis.patch.yml README.md README.zh-CN.md CONTRIBUTING.md CONTRIBUTING.zh-CN.md docs .github/workflows",
    "check:package": "node scripts/check-package.mjs",
    "probe:live": "node scripts/probe-live.mjs",
    "prepack": "pnpm build",
    "probe:host": "node --expose-internals scripts/probe-host.mjs",
    "hooks:install": "simple-git-hooks",
    "verify": "pnpm typecheck && pnpm format:check && pnpm test && pnpm build && pnpm check:package"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/build-before-commit.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@tanstack/ai": "0.58.0",
    "@tanstack/ai-typesafe": "0.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^22.0.0",
    "prettier": "3.9.8",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exoticknight/dsh-system1.git"
  },
  "homepage": "https://github.com/exoticknight/dsh-system1#readme",
  "bugs": {
    "url": "https://github.com/exoticknight/dsh-system1/issues"
  }
}
