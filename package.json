{
  "name": "dsh-system1",
  "version": "0.1.1",
  "description": "Typed System One decision service for DeepSeek Harness plugins",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "system-one",
    "system1",
    "decision-service",
    "cordis",
    "typescript",
    "typesafe",
    "jev",
    "laya"
  ],
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "import": "./lib/contracts/index.js"
    },
    "./providers/typesafe": {
      "types": "./lib/providers/typesafe/index.d.ts",
      "import": "./lib/providers/typesafe/index.js"
    },
    "./providers/typesafe/locale/*.json": "./locale/providers/typesafe/*.json",
    "./providers": {
      "types": "./lib/providers/index.d.ts",
      "import": "./lib/providers/index.js"
    },
    "./providers/laya": {
      "types": "./lib/providers/laya/index.d.ts",
      "import": "./lib/providers/laya/index.js"
    },
    "./providers/laya/locale/*.json": "./locale/providers/laya/*.json",
    "./providers/cloudflare": {
      "types": "./lib/providers/cloudflare/index.d.ts",
      "import": "./lib/providers/cloudflare/index.js"
    },
    "./providers/cloudflare/locale/*.json": "./locale/providers/cloudflare/*.json",
    "./tool": {
      "types": "./lib/tool/index.d.ts",
      "import": "./lib/tool/index.js"
    },
    "./tool/locale/*.json": "./locale/tool/*.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "docs",
    "examples"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1 <0.3.0",
      "dshReleases": {
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "profiles": [
        "headless",
        "web"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node scripts/test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "probe": "node scripts/probe/index.mjs",
    "probe:host": "node --expose-internals scripts/probe/host.mjs",
    "hooks:install": "simple-git-hooks",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check:package"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/build-before-commit.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exoticknight/dsh-system1.git"
  },
  "homepage": "https://github.com/exoticknight/dsh-system1#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/exoticknight/dsh-system1/issues"
  }
}
